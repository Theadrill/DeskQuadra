<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeskQuadra.Core\DeskQuadra.Core.csproj" />
    <ProjectReference Include="..\DeskQuadra.Application\DeskQuadra.Application.csproj" />
    <ProjectReference Include="..\DeskQuadra.Infrastructure.WindowsShell\DeskQuadra.Infrastructure.WindowsShell.csproj" />
    <ProjectReference Include="..\DeskQuadra.Infrastructure.Persistence\DeskQuadra.Infrastructure.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <!-- O App localiza o Guardian primeiro em $(TargetDir); sem esta cópia o exe/dll ao lado
       do UI fica obsoleto e o pânico (hotkey nova) não existe no processo em execução.
       ATENÇÃO: copiar exe+dll+pdb+deps.json+runtimeconfig (o código gerenciado vive na DLL;
       só o exe é o apphost nativo — copiar só o exe mantém o Guardian velho!).
       ReferenceOutputAssembly=false: só garante o build do Guardian antes, sem referenciar. -->
  <ItemGroup>
    <ProjectReference Include="..\DeskQuadra.Guardian\DeskQuadra.Guardian.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!-- T5 isolamento: garante o build do ShellHost antes da UI, sem
         referenciar (o cliente localiza o exe ao lado da UI em runtime). -->
    <ProjectReference Include="..\DeskQuadra.ShellHost\DeskQuadra.ShellHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyGuardianToOutput" AfterTargets="Build">
    <Copy SourceFiles="..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\DeskQuadra.Guardian.exe;..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\DeskQuadra.Guardian.dll;..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\DeskQuadra.Guardian.pdb;..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\DeskQuadra.Guardian.deps.json;..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\DeskQuadra.Guardian.runtimeconfig.json"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Portátil 1.0: no `dotnet publish -r win-x64` o Guardian fresco sai em
       bin\$(Configuration)\net8.0-windows\win-x64\ (com RID); o alvo acima lê o
       caminho sem RID e o publish ficava sem Guardian (ou com binário velho).
       Este alvo leva exe+dll+pdb+deps.json+runtimeconfig frescos para $(PublishDir). -->
  <Target Name="CopyGuardianToPublish" AfterTargets="Publish">
    <Copy SourceFiles="..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.Guardian.exe;..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.Guardian.dll;..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.Guardian.pdb;..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.Guardian.deps.json;..\DeskQuadra.Guardian\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.Guardian.runtimeconfig.json"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="false" />
  </Target>

  <!-- T5 isolamento (MESMO molde do Guardian acima, sem quebrar o dele):
       o ShellHost anda ao lado da UI (exe+dll+pdb+deps.json+runtimeconfig —
       o código gerenciado vive na DLL; só o exe é o apphost nativo).
       As demais deps do host (Core, Vanara) já estão ao lado da UI pela
       referência normal. Sem estes alvos o cliente não acha o exe e o menu
       cai no placeholder (silencioso). -->
  <Target Name="CopyShellHostToOutput" AfterTargets="Build">
    <Copy SourceFiles="..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\DeskQuadra.ShellHost.exe;..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\DeskQuadra.ShellHost.dll;..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\DeskQuadra.ShellHost.pdb;..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\DeskQuadra.ShellHost.deps.json;..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\DeskQuadra.ShellHost.runtimeconfig.json"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyShellHostToPublish" AfterTargets="Publish">
    <Copy SourceFiles="..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.ShellHost.exe;..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.ShellHost.dll;..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.ShellHost.pdb;..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.ShellHost.deps.json;..\DeskQuadra.ShellHost\bin\$(Configuration)\net8.0-windows\win-x64\DeskQuadra.ShellHost.runtimeconfig.json"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="false" />
  </Target>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Release 1.0: carimbo único de versão do portátil (FileVersion 1.0.0 no smoke). -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Ícone próprio (Fase 5): exe + janelas + tray a partir de Assets/DeskQuadra.ico. -->
    <ApplicationIcon>Assets\DeskQuadra.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Fonte única do ícone (Resource embutido: XAML via Icon + AppIcon.cs via pack URI).
       Tray usa variante própria com crop justo (a arte cheia some na taskbar escura em 16px). -->
  <ItemGroup>
    <Resource Include="Assets\DeskQuadra.ico" />
    <Resource Include="Assets\DeskQuadra.Tray.ico" />
  </ItemGroup>

  <!-- Remove os usings implícitos do WinForms para não ambiguar com tipos WPF (Button, Point, MouseEventArgs...).
       O tray usa alias "WinForms =" e System.Drawing qualificado em App.xaml.cs. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- Strings visíveis pt-BR centralizadas (REFATOR PURO: mesmo texto, só troca literal por Strings.Chave).
       pt-BR default, único idioma. CustomTool PublicResXFileCodeGenerator (public static,
       exigido por {x:Static} no XAML — ResXFileCodeGenerator geraria internal e quebraria
       o InitializeComponent com XamlParseException). -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
  </ItemGroup>

</Project>
