<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeskQuadra.Core\DeskQuadra.Core.csproj" />
    <ProjectReference Include="..\DeskQuadra.Application\DeskQuadra.Application.csproj" />
    <ProjectReference Include="..\DeskQuadra.Infrastructure.WindowsShell\DeskQuadra.Infrastructure.WindowsShell.csproj" />
    <ProjectReference Include="..\DeskQuadra.Infrastructure.Persistence\DeskQuadra.Infrastructure.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Remove os usings implícitos do WinForms para não ambiguar com tipos WPF (Button, Point, MouseEventArgs...).
       O tray usa alias "WinForms =" e System.Drawing qualificado em App.xaml.cs. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
