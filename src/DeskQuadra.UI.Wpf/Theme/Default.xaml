<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- ============================================================
         DeskQuadra — Tema Default (seam de temas, REFATOR PURO)
         Valores idênticos aos literais chapados anteriores.
         Nenhum pixel muda. Uso via {DynamicResource Chave} no XAML
         e via TryFindResource("Chave") no code-behind.
         ============================================================ -->

    <!-- ===== Quadra: container ===== -->
    <SolidColorBrush x:Key="Quadra.Background" Color="#47141418"/>
    <SolidColorBrush x:Key="Quadra.BorderBrush" Color="#38FFFFFF"/>
    <Thickness x:Key="Quadra.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Quadra.CornerRadius">8</CornerRadius>
    <Color x:Key="Quadra.Shadow.Color">#000000</Color>
    <sys:Double x:Key="Quadra.Shadow.BlurRadius">16</sys:Double>
    <sys:Double x:Key="Quadra.Shadow.Depth">2</sys:Double>
    <sys:Double x:Key="Quadra.Shadow.Opacity">0.45</sys:Double>

    <!-- ===== Quadra: barra de título ===== -->
    <SolidColorBrush x:Key="Quadra.Title.Background" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Quadra.Title.BorderBrush" Color="#1AFFFFFF"/>
    <Thickness x:Key="Quadra.Title.BorderThickness">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="Quadra.Title.Foreground" Color="#F5F5F5"/>
    <sys:Double x:Key="Quadra.Title.FontSize">12</sys:Double>
    <FontWeight x:Key="Quadra.Title.FontWeight">SemiBold</FontWeight>
    <Color x:Key="Quadra.Title.Shadow.Color">#000000</Color>
    <sys:Double x:Key="Quadra.Title.Shadow.BlurRadius">2</sys:Double>
    <sys:Double x:Key="Quadra.Title.Shadow.Depth">1</sys:Double>
    <sys:Double x:Key="Quadra.Title.Shadow.Opacity">0.85</sys:Double>

    <!-- ===== Quadra: botões da barra de título ===== -->
    <SolidColorBrush x:Key="Quadra.TitleButton.Foreground" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Quadra.TitleButton.Hover.Background" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Quadra.TitleButton.Hover.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Quadra.TitleButton.Pressed.Background" Color="#4DFFFFFF"/>
    <CornerRadius x:Key="Quadra.TitleButton.CornerRadius">4</CornerRadius>
    <sys:Double x:Key="Quadra.TitleButton.Size">24</sys:Double>
    <Thickness x:Key="Quadra.TitleButton.BorderThickness">0</Thickness>
    <sys:Double x:Key="Quadra.Lock.FontSize">11</sys:Double>
    <sys:Double x:Key="Quadra.CollapseGlyph.FontSize">12</sys:Double>
    <sys:Double x:Key="Quadra.AddGlyph.FontSize">14</sys:Double>
    <sys:Double x:Key="Quadra.CloseGlyph.FontSize">10</sys:Double>

    <!-- ===== Quadra: densidade Normal (28/24) vs Touch (42/44) — Fatia 2 ===== -->
    <!-- Normal = valores abaixo; Touch aplicado via código (42, padding maior). -->
    <GridLength x:Key="Quadra.Density.TitleBar.Height">28</GridLength>
    <Thickness x:Key="Quadra.Density.Title.Padding">8,0,4,0</Thickness>
    <Thickness x:Key="Quadra.Density.TitleButton.Margin">0,0,2,0</Thickness>
    <!-- Fatia vertical: ícone cresce DENTRO da célula fixa 78x96 (snap D9 intacto). -->
    <!-- Normal 38 via resolver; Touch 48 escrito por ApplyDensity. -->
    <sys:Double x:Key="Quadra.Density.Icon.Size">38</sys:Double>
    <!-- Respiro Touch do item (Normal vive em Quadra.Item.Padding/Margin abaixo). -->
    <Thickness x:Key="Quadra.Item.Padding.Touch">8,8,8,4</Thickness>
    <Thickness x:Key="Quadra.Item.Margin.Touch">4</Thickness>

    <!-- ===== Quadra: mensagem de vazio ===== -->
    <SolidColorBrush x:Key="Quadra.Empty.BorderBrush" Color="#14FFFFFF"/>
    <Thickness x:Key="Quadra.Empty.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Quadra.Empty.CornerRadius">4</CornerRadius>
    <Thickness x:Key="Quadra.Empty.Padding">12,8</Thickness>
    <SolidColorBrush x:Key="Quadra.Empty.Foreground" Color="#CCCCCC"/>
    <sys:Double x:Key="Quadra.Empty.FontSize">11</sys:Double>
    <FontStyle x:Key="Quadra.Empty.FontStyle">Italic</FontStyle>

    <!-- ===== Quadra: itens / atalhos ===== -->
    <SolidColorBrush x:Key="Quadra.Item.Foreground" Color="#F5F5F5"/>
    <sys:Double x:Key="Quadra.Item.FontSize">11</sys:Double>
    <sys:Double x:Key="Quadra.Item.LineHeight">14</sys:Double>
    <CornerRadius x:Key="Quadra.Item.CornerRadius">6</CornerRadius>
    <Thickness x:Key="Quadra.Item.Padding">4,4,4,2</Thickness>
    <Thickness x:Key="Quadra.Item.Margin">2</Thickness>
    <SolidColorBrush x:Key="Quadra.Item.Hover.Background" Color="#25FFFFFF"/>
    <SolidColorBrush x:Key="Quadra.Item.Hover.BorderBrush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="Quadra.Item.Selected.Background" Color="#380078D4"/>
    <SolidColorBrush x:Key="Quadra.Item.Selected.BorderBrush" Color="#60CDFF"/>
    <Thickness x:Key="Quadra.Item.BorderThickness">1</Thickness>
    <Color x:Key="Quadra.Item.Shadow.Color">#000000</Color>
    <sys:Double x:Key="Quadra.Item.Shadow.BlurRadius">3</sys:Double>
    <sys:Double x:Key="Quadra.Item.Shadow.Depth">1</sys:Double>
    <sys:Double x:Key="Quadra.Item.Shadow.Opacity">0.85</sys:Double>
    <SolidColorBrush x:Key="Quadra.Separator.Background" Color="#26FFFFFF"/>
    <Thickness x:Key="Quadra.Separator.Margin">4,2</Thickness>

    <!-- ===== Menu de contexto (WPF) ===== -->
    <SolidColorBrush x:Key="Menu.Background" Color="#EB1C1C22"/>
    <SolidColorBrush x:Key="Menu.BorderBrush" Color="#44FFFFFF"/>
    <Thickness x:Key="Menu.BorderThickness">1</Thickness>
    <SolidColorBrush x:Key="Menu.Foreground" Color="#F5F5F5"/>
    <Thickness x:Key="Menu.Padding">4</Thickness>
    <CornerRadius x:Key="Menu.CornerRadius">8</CornerRadius>
    <Color x:Key="Menu.Shadow.Color">#000000</Color>
    <sys:Double x:Key="Menu.Shadow.BlurRadius">16</sys:Double>
    <sys:Double x:Key="Menu.Shadow.Depth">3</sys:Double>
    <sys:Double x:Key="Menu.Shadow.Opacity">0.55</sys:Double>

    <SolidColorBrush x:Key="Menu.MouseItem.Foreground" Color="#EEEEEE"/>
    <sys:Double x:Key="Menu.MouseItem.FontSize">14.4</sys:Double>
    <sys:Double x:Key="Menu.MouseItem.MinHeight">26</sys:Double>
    <Thickness x:Key="Menu.MouseItem.Padding">10,5</Thickness>
    <CornerRadius x:Key="Menu.MouseItem.CornerRadius">4</CornerRadius>
    <SolidColorBrush x:Key="Menu.MouseItem.Hover.Background" Color="#2EFFFFFF"/>

    <SolidColorBrush x:Key="Menu.TouchItem.Foreground" Color="#FFFFFF"/>
    <sys:Double x:Key="Menu.TouchItem.FontSize">15.6</sys:Double>
    <FontWeight x:Key="Menu.TouchItem.FontWeight">Medium</FontWeight>
    <sys:Double x:Key="Menu.TouchItem.MinHeight">46</sys:Double>
    <Thickness x:Key="Menu.TouchItem.Padding">16,12</Thickness>
    <CornerRadius x:Key="Menu.TouchItem.CornerRadius">6</CornerRadius>
    <SolidColorBrush x:Key="Menu.TouchItem.Hover.Background" Color="#4D0078D4"/>
    <SolidColorBrush x:Key="Menu.TouchItem.Pressed.Background" Color="#800078D4"/>

    <!-- ===== Separador de menu (T1 terceiros: UM Style compartilhado, REUSE tokens
         Quadra.Separator.* — nunca estilo inline; Separator não é MenuItem, então
         ApplyStyleRecursively o ignora e ele mantém este visual nas 2 densidades) ===== -->
    <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Quadra.Separator.Background}"/>
        <Setter Property="Margin" Value="{DynamicResource Quadra.Separator.Margin}"/>
    </Style>

    <!-- ===== Seleção de área (retângulo de desenho) ===== -->
    <SolidColorBrush x:Key="Selection.Background" Color="#800078D4"/>
    <SolidColorBrush x:Key="Selection.BorderBrush" Color="#60CDFF"/>
    <Thickness x:Key="Selection.BorderThickness">1.5</Thickness>
    <CornerRadius x:Key="Selection.CornerRadius">6</CornerRadius>
    <Color x:Key="Selection.Shadow.Color">#0078D4</Color>
    <sys:Double x:Key="Selection.Shadow.BlurRadius">8</sys:Double>
    <sys:Double x:Key="Selection.Shadow.Depth">0</sys:Double>
    <sys:Double x:Key="Selection.Shadow.Opacity">0.4</sys:Double>
    <SolidColorBrush x:Key="Selection.Foreground" Color="#FFFFFF"/>
    <sys:Double x:Key="Selection.FontSize">11</sys:Double>
    <FontWeight x:Key="Selection.FontWeight">SemiBold</FontWeight>
    <Color x:Key="Selection.Text.Shadow.Color">#000000</Color>
    <sys:Double x:Key="Selection.Text.Shadow.BlurRadius">3</sys:Double>
    <sys:Double x:Key="Selection.Text.Shadow.Depth">1</sys:Double>
    <sys:Double x:Key="Selection.Text.Shadow.Opacity">0.8</sys:Double>

    <!-- ===== Diálogos escuros (code-behind: Services/DarkDialog) ===== -->
    <SolidColorBrush x:Key="Dialog.Background" Color="#FF1F1F24"/>
    <SolidColorBrush x:Key="Dialog.Foreground" Color="#FFF5F5F5"/>
    <sys:Double x:Key="Dialog.Message.FontSize">13</sys:Double>
    <Thickness x:Key="Dialog.Panel.Margin">16</Thickness>
    <Thickness x:Key="Dialog.Message.Margin">0,0,0,14</Thickness>
    <SolidColorBrush x:Key="Dialog.Primary.Background" Color="#FF0078D4"/>
    <!-- F1: texto do botão primário (branco sobre #0078D4, 4.5:1) -->
    <SolidColorBrush x:Key="Dialog.Primary.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Dialog.Secondary.Background" Color="#28FFFFFF"/>
    <Thickness x:Key="Dialog.Button.Padding">14,6,14,6</Thickness>
    <Thickness x:Key="Dialog.Button.Margin">6,0,0,0</Thickness>
    <sys:Double x:Key="Dialog.Button.FontSize">12</sys:Double>
    <Thickness x:Key="Dialog.Button.BorderThickness">0</Thickness>

    <!-- ===== Menu de criação (code-behind: ShowDualCreationMenu) ===== -->
    <SolidColorBrush x:Key="CreationMenu.Background" Color="#FF1F1F24"/>
    <SolidColorBrush x:Key="CreationMenu.BorderBrush" Color="#40FFFFFF"/>
    <Thickness x:Key="CreationMenu.BorderThickness">1</Thickness>
    <CornerRadius x:Key="CreationMenu.CornerRadius">8</CornerRadius>
    <Thickness x:Key="CreationMenu.Padding">4</Thickness>
    <Color x:Key="CreationMenu.Shadow.Color">#000000</Color>
    <sys:Double x:Key="CreationMenu.Shadow.BlurRadius">14</sys:Double>
    <sys:Double x:Key="CreationMenu.Shadow.Depth">2</sys:Double>
    <sys:Double x:Key="CreationMenu.Shadow.Opacity">0.55</sys:Double>
    <SolidColorBrush x:Key="CreationMenu.Primary.Foreground" Color="#FFF5F5F5"/>
    <Thickness x:Key="CreationMenu.Primary.Padding">12,8,12,8</Thickness>
    <sys:Double x:Key="CreationMenu.Primary.FontSize">12</sys:Double>
    <FontWeight x:Key="CreationMenu.Primary.FontWeight">SemiBold</FontWeight>
    <SolidColorBrush x:Key="CreationMenu.Secondary.Foreground" Color="#FFBBBBBB"/>
    <Thickness x:Key="CreationMenu.Secondary.Padding">12,6,12,6</Thickness>
    <sys:Double x:Key="CreationMenu.Secondary.FontSize">11</sys:Double>
    <SolidColorBrush x:Key="CreationMenu.Hover.Background" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="CreationMenu.Hover.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CreationMenu.Separator.Background" Color="#18FFFFFF"/>
    <Thickness x:Key="CreationMenu.Separator.Margin">4,2,4,2</Thickness>
    <Thickness x:Key="CreationMenu.Button.BorderThickness">0</Thickness>
    <sys:Double x:Key="CreationMenu.Button.MinHeight">32</sys:Double>
    <sys:Double x:Key="CreationMenu.Button.MinHeight.Touch">44</sys:Double>

    <!-- ===== Preview de arrasto (code-behind: DragPreviewWindow) ===== -->
    <SolidColorBrush x:Key="DragPreview.Background" Color="#DC18181E"/>
    <SolidColorBrush x:Key="DragPreview.BorderBrush" Color="#5AFFFFFF"/>
    <Thickness x:Key="DragPreview.BorderThickness">1</Thickness>
    <CornerRadius x:Key="DragPreview.CornerRadius">8</CornerRadius>
    <Thickness x:Key="DragPreview.Padding">8,6,12,6</Thickness>
    <Color x:Key="DragPreview.Shadow.Color">#000000</Color>
    <sys:Double x:Key="DragPreview.Shadow.BlurRadius">14</sys:Double>
    <sys:Double x:Key="DragPreview.Shadow.Depth">3</sys:Double>
    <sys:Double x:Key="DragPreview.Shadow.Opacity">0.55</sys:Double>
    <SolidColorBrush x:Key="DragPreview.Foreground" Color="#FFF5F5F5"/>
    <sys:Double x:Key="DragPreview.FontSize">12</sys:Double>
    <FontWeight x:Key="DragPreview.FontWeight">SemiBold</FontWeight>
    <!-- ===== Faixa do overview MOVER-via-touch: botão CANCELAR (fundo opaco; par medido) ===== -->
    <!-- Escolha: sem token vermelho de perigo no tema (só Dialog.Primary azul); par novo -->
    <!-- TouchMove.Cancel.* validado: branco s/ #B3261E = 6.54:1 ≥ 4.5 AA). -->
    <SolidColorBrush x:Key="TouchMove.Cancel.Background" Color="#FFB3261E"/>
    <SolidColorBrush x:Key="TouchMove.Cancel.Foreground" Color="#FFFFFFFF"/>
</ResourceDictionary>
