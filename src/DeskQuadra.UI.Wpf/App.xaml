<Application x:Class="DeskQuadra.UI.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeskQuadra.UI.Wpf"
             ShutdownMode="OnExplicitShutdown">
     <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Estilo moderno do Menu de Contexto (Acrílico Escuro Fluent) -->
        <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Menu.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Menu.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Menu.BorderThickness}"/>
            <Setter Property="Foreground" Value="{DynamicResource Menu.Foreground}"/>
            <Setter Property="Padding" Value="{DynamicResource Menu.Padding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Menu.CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{DynamicResource Menu.Shadow.BlurRadius}" ShadowDepth="{DynamicResource Menu.Shadow.Depth}" Opacity="{DynamicResource Menu.Shadow.Opacity}" Color="{DynamicResource Menu.Shadow.Color}"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Compacto para Mouse (~26px) -->
        <!-- Suporta submenu: folha mantém o mesmo Border/pixel; pai usa PART_Popup + seta "›" -->
        <Style x:Key="MouseMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Menu.MouseItem.Foreground}"/>
            <Setter Property="FontSize" Value="{DynamicResource Menu.MouseItem.FontSize}"/>
            <Setter Property="MinHeight" Value="{DynamicResource Menu.MouseItem.MinHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource Menu.MouseItem.Padding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <!-- Área do item-folha: visual idêntico ao anterior (sem deslocamento de pixel) -->
                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="{DynamicResource Menu.MouseItem.CornerRadius}" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    <!-- Seta só aparece no item-pai (HasItems); Collapsed não afeta a folha -->
                                    <TextBlock x:Name="SubmenuArrow" Grid.Column="1" Text="›" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Opacity="0.7"
                                               FontSize="{TemplateBinding FontSize}" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- Popup do submenu no padrão Fluent escuro do ModernContextMenuStyle -->
                            <!-- Nome PART_Popup é obrigatório: o MenuItem procura esse filho para abrir o submenu -->
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-4"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="{DynamicResource Menu.Background}"
                                        BorderBrush="{DynamicResource Menu.BorderBrush}"
                                        BorderThickness="{DynamicResource Menu.BorderThickness}"
                                        CornerRadius="{DynamicResource Menu.CornerRadius}"
                                        Padding="{DynamicResource Menu.Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="{DynamicResource Menu.Shadow.BlurRadius}" ShadowDepth="{DynamicResource Menu.Shadow.Depth}" Opacity="{DynamicResource Menu.Shadow.Opacity}" Color="{DynamicResource Menu.Shadow.Color}"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Menu.MouseItem.Hover.Background}"/>
                            </Trigger>
                            <!-- Mostra a seta só no item-pai -->
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Mantém o destaque do pai enquanto o submenu está aberto -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Menu.MouseItem.Hover.Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Ergonômico Espaçoso para Toque com o Dedo (Touch - 46px com alvo mínimo WCAG 44px+) -->
        <!-- Suporta submenu: folha mantém o mesmo Border/pixel; pai usa PART_Popup + seta "›" -->
        <Style x:Key="TouchMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Menu.TouchItem.Foreground}"/>
            <Setter Property="FontSize" Value="{DynamicResource Menu.TouchItem.FontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource Menu.TouchItem.FontWeight}"/>
            <Setter Property="MinHeight" Value="{DynamicResource Menu.TouchItem.MinHeight}"/>
            <Setter Property="Padding" Value="{DynamicResource Menu.TouchItem.Padding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <!-- Área do item-folha: visual idêntico ao anterior (sem deslocamento de pixel) -->
                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="{DynamicResource Menu.TouchItem.CornerRadius}" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    <!-- Seta só aparece no item-pai (HasItems); Collapsed não afeta a folha -->
                                    <TextBlock x:Name="SubmenuArrow" Grid.Column="1" Text="›" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Opacity="0.7"
                                               FontSize="{TemplateBinding FontSize}" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- Popup do submenu no padrão Fluent escuro do ModernContextMenuStyle -->
                            <!-- Nome PART_Popup é obrigatório: o MenuItem procura esse filho para abrir o submenu -->
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-4"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="{DynamicResource Menu.Background}"
                                        BorderBrush="{DynamicResource Menu.BorderBrush}"
                                        BorderThickness="{DynamicResource Menu.BorderThickness}"
                                        CornerRadius="{DynamicResource Menu.CornerRadius}"
                                        Padding="{DynamicResource Menu.Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="{DynamicResource Menu.Shadow.BlurRadius}" ShadowDepth="{DynamicResource Menu.Shadow.Depth}" Opacity="{DynamicResource Menu.Shadow.Opacity}" Color="{DynamicResource Menu.Shadow.Color}"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Menu.TouchItem.Hover.Background}"/>
                            </Trigger>
                            <!-- Mostra a seta só no item-pai -->
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Mantém o destaque do pai enquanto o submenu está aberto -->
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Menu.TouchItem.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Menu.TouchItem.Pressed.Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Botões de Ação Rápida no topo do Menu de Contexto (Estilo Windows 11) ===== -->
        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Menu.QuickAction.Foreground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2,4,2,3"/>
            <Setter Property="MinHeight" Value="{DynamicResource Menu.QuickAction.Button.Height}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource Menu.QuickAction.Hover.Background}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource Menu.QuickAction.Pressed.Background}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ToolTip Moderno Fluent (visual escuro estilo Menu) ===== -->
        <Style x:Key="ModernToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Menu.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Menu.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Menu.BorderThickness}"/>
            <Setter Property="Foreground" Value="{DynamicResource Menu.Foreground}"/>
            <Setter Property="FontSize" Value="{DynamicResource ToolTip.FontSize}"/>
            <Setter Property="Padding" Value="{DynamicResource ToolTip.Padding}"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{DynamicResource ToolTip.MaxWidth}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ToolTip.CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{DynamicResource Menu.Shadow.BlurRadius}"
                                                  ShadowDepth="{DynamicResource Menu.Shadow.Depth}"
                                                  Opacity="{DynamicResource Menu.Shadow.Opacity}"
                                                  Color="{DynamicResource Menu.Shadow.Color}"/>
                            </Border.Effect>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip" BasedOn="{StaticResource ModernToolTipStyle}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
