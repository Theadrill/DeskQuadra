<Window x:Class="DeskQuadra.UI.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:DeskQuadra.UI.Wpf.Properties"
        Title="{x:Static properties:Strings.SettingsTitle}"
        Icon="/Assets/DeskQuadra.ico"
        WindowStartupLocation="CenterScreen"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        Background="{DynamicResource Dialog.Background}">
    <Window.Resources>
        <!-- Aparência: 3 RadioButtons com cara de Button. Reusa o binding IsDensity* -->
        <!-- existente (persistência via SettingsViewModel inalterada). Ativo = -->
        <!-- Dialog.Primary.Background; inativo = Dialog.Secondary.Background. -->
        <Style x:Key="DensityButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Dialog.Foreground}"/>
            <Setter Property="FontSize" Value="{DynamicResource Dialog.Button.FontSize}"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Dialog.Button.BorderThickness}"/>
            <Setter Property="Background" Value="{DynamicResource Dialog.Secondary.Background}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dialog.Primary.Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>
    <StackPanel Margin="{DynamicResource Dialog.Panel.Margin}">
        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                  Content="{x:Static properties:Strings.SettingsStartup}"
                  Foreground="{DynamicResource Dialog.Foreground}"
                  FontSize="{DynamicResource Dialog.Message.FontSize}"
                  Margin="{DynamicResource Dialog.Message.Margin}"
                  VerticalContentAlignment="Center"/>
        <CheckBox IsChecked="{Binding EnableWindows11VisualEffects, Mode=TwoWay}"
                  Content="{x:Static properties:Strings.SettingsVisualEffectsWindows11}"
                  Foreground="{DynamicResource Dialog.Foreground}"
                  FontSize="{DynamicResource Dialog.Message.FontSize}"
                  Margin="{DynamicResource Dialog.Message.Margin}"
                  VerticalContentAlignment="Center"
                  Visibility="{Binding IsVisualEffectsSupported, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Seleção da técnica visual: exibida quando os efeitos estão ativos -->
        <StackPanel Margin="24,0,0,8" Visibility="{Binding IsTechniqueSelectorVisible, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="Técnica de Desfoque"
                       Foreground="{DynamicResource Dialog.Foreground}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,4">
                <RadioButton GroupName="VisualTechnique"
                             Style="{StaticResource DensityButtonStyle}"
                             IsChecked="{Binding IsTechniqueAuto, Mode=TwoWay}"
                             Content="Automático"
                             ToolTip="Seleciona automaticamente a técnica ideal recomendada para a sua versão do Windows."
                             Margin="0"/>
                <RadioButton GroupName="VisualTechnique"
                             Style="{StaticResource DensityButtonStyle}"
                             IsChecked="{Binding IsTechniqueAcrylic, Mode=TwoWay}"
                             IsEnabled="{Binding IsAcrylicSupported}"
                             Content="Acrílico (Win 11)"
                             ToolTip="{Binding AcrylicOptionToolTip}"
                             Margin="{DynamicResource Dialog.Button.Margin}"/>
                <RadioButton GroupName="VisualTechnique"
                             Style="{StaticResource DensityButtonStyle}"
                             IsChecked="{Binding IsTechniqueClassicBlur, Mode=TwoWay}"
                             Content="Blur (Win 10)"
                             ToolTip="Desfoque translúcido límpido estilo vidro clássico do Windows 10."
                             Margin="{DynamicResource Dialog.Button.Margin}"/>
            </UniformGrid>
        </StackPanel>

        <TextBlock Text="{Binding VisualEffectsDetail}"
                   Foreground="{DynamicResource Dialog.Foreground}"
                   Opacity="0.65"
                   FontSize="10.5"
                   Margin="24,0,0,12"
                   TextWrapping="Wrap"/>
        <TextBlock Text="{x:Static properties:Strings.SettingsAppearanceTitle}"
                   Foreground="{DynamicResource Dialog.Foreground}"
                   FontSize="{DynamicResource Dialog.Message.FontSize}"
                   FontWeight="SemiBold"
                   Margin="0,4,0,6"/>
        <UniformGrid Rows="1" Columns="3" Margin="0,2,0,2">
            <RadioButton GroupName="Density"
                         Style="{StaticResource DensityButtonStyle}"
                         IsChecked="{Binding IsDensityAuto, Mode=TwoWay}"
                         Content="{x:Static properties:Strings.SettingsDensityAuto}"
                         Margin="0"/>
            <RadioButton GroupName="Density"
                         Style="{StaticResource DensityButtonStyle}"
                         IsChecked="{Binding IsDensityNormal, Mode=TwoWay}"
                         Content="{x:Static properties:Strings.SettingsDensityNormal}"
                         Margin="{DynamicResource Dialog.Button.Margin}"/>
            <RadioButton GroupName="Density"
                         Style="{StaticResource DensityButtonStyle}"
                         IsChecked="{Binding IsDensityTouch, Mode=TwoWay}"
                         Content="{x:Static properties:Strings.SettingsDensityTouch}"
                         Margin="{DynamicResource Dialog.Button.Margin}"/>
        </UniformGrid>
    </StackPanel>
</Window>

