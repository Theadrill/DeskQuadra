<Window x:Class="DeskQuadra.UI.Wpf.Views.DesktopSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:DeskQuadra.UI.Wpf.Properties"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">
    <Grid>
        <Border Background="{DynamicResource Selection.Background}"
                BorderBrush="{DynamicResource Selection.BorderBrush}"
                BorderThickness="{DynamicResource Selection.BorderThickness}"
                CornerRadius="{DynamicResource Selection.CornerRadius}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="{DynamicResource Selection.Shadow.BlurRadius}"
                                  ShadowDepth="{DynamicResource Selection.Shadow.Depth}"
                                  Opacity="{DynamicResource Selection.Shadow.Opacity}"
                                  Color="{DynamicResource Selection.Shadow.Color}"/>
            </Border.Effect>
            <TextBlock x:Name="DimensionText"
                       Text="{x:Static properties:Strings.Selection_NewQuadra}"
                       Foreground="{DynamicResource Selection.Foreground}"
                       FontSize="{DynamicResource Selection.FontSize}"
                       FontWeight="{DynamicResource Selection.FontWeight}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="{DynamicResource Selection.Text.Shadow.BlurRadius}"
                                      ShadowDepth="{DynamicResource Selection.Text.Shadow.Depth}"
                                      Opacity="{DynamicResource Selection.Text.Shadow.Opacity}"
                                      Color="{DynamicResource Selection.Text.Shadow.Color}"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>
    </Grid>
</Window>
