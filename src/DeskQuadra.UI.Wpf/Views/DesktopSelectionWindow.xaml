<Window x:Class="DeskQuadra.UI.Wpf.Views.DesktopSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">
    <Grid>
        <Border Background="#240078D4"
                BorderBrush="#60CDFF"
                BorderThickness="1.5"
                CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.4"
                                  Color="#0078D4"/>
            </Border.Effect>
            <TextBlock x:Name="DimensionText"
                       Text="Nova Quadra"
                       Foreground="#FFFFFF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="3"
                                      ShadowDepth="1"
                                      Opacity="0.8"
                                      Color="#000000"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>
    </Grid>
</Window>
