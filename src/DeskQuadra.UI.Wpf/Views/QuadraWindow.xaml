<Window x:Class="DeskQuadra.UI.Wpf.Views.QuadraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:viewmodels="clr-namespace:DeskQuadra.UI.Wpf.ViewModels"
        xmlns:properties="clr-namespace:DeskQuadra.UI.Wpf.Properties"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:QuadraViewModel}"
        Title="{Binding Title}"
        Icon="/Assets/DeskQuadra.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MinWidth="200"
        MinHeight="140"
        Width="{Binding Width, Mode=TwoWay}"
        Height="{Binding Height, Mode=TwoWay}"
        Left="{Binding Left, Mode=TwoWay}"
        Top="{Binding Top, Mode=TwoWay}">

    <Window.Resources>
        <!-- Estilo base para os manipuladores transparentes de redimensionamento -->
        <Style x:Key="ResizeThumbStyle" TargetType="primitives:Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do botão fechar na barra de título -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Quadra.TitleButton.Foreground}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Quadra.TitleButton.BorderThickness}"/>
            <Setter Property="Width" Value="{DynamicResource Quadra.TitleButton.Size}"/>
            <Setter Property="Height" Value="{DynamicResource Quadra.TitleButton.Size}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Quadra.TitleButton.CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Quadra.TitleButton.Hover.Background}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Quadra.TitleButton.Hover.Foreground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Quadra.TitleButton.Pressed.Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Grid principal contendo margem externa para a sombra projetada -->
    <Grid Margin="10">
        <!-- Container visual da Quadra: cantos arredondados, acrílico translúcido e borda suave -->
        <Border x:Name="QuadraContainer"
                Background="{DynamicResource Quadra.Background}"
                BorderBrush="{DynamicResource Quadra.BorderBrush}"
                BorderThickness="{DynamicResource Quadra.BorderThickness}"
                CornerRadius="{DynamicResource Quadra.CornerRadius}"
                ClipToBounds="True"
                AllowDrop="True"
                DragOver="Quadra_DragOver"
                Drop="Quadra_Drop"
                DragLeave="Quadra_DragLeave"
                PreviewMouseDown="QuadraContainer_PreviewMouseDown"
                PreviewMouseMove="QuadraContainer_PreviewMouseMove"
                PreviewMouseLeftButtonUp="QuadraContainer_PreviewMouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="{DynamicResource Quadra.Shadow.BlurRadius}"
                                   ShadowDepth="{DynamicResource Quadra.Shadow.Depth}"
                                   Opacity="{DynamicResource Quadra.Shadow.Opacity}"
                                   Color="{DynamicResource Quadra.Shadow.Color}"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Barra de título por densidade (Normal 28 / Touch 42 via Quadra.Density.TitleBar.Height) -->
                    <RowDefinition x:Name="TitleBarRow" Height="{DynamicResource Quadra.Density.TitleBar.Height}"/>
                    <!-- Área do conteúdo / atalhos -->
                    <RowDefinition x:Name="ContentRow" Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de título interativa -->
                <Border x:Name="TitleBarBorder"
                        Grid.Row="0"
                        Background="{DynamicResource Quadra.Title.Background}"
                        BorderBrush="{DynamicResource Quadra.Title.BorderBrush}"
                        BorderThickness="{DynamicResource Quadra.Title.BorderThickness}"
                         MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                         MouseMove="TitleBar_MouseMove"
                        MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                        LostMouseCapture="TitleBar_LostMouseCapture"
                        ContextMenuOpening="TitleBar_ContextMenuOpening">
                    <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                            <MenuItem Header="{x:Static properties:Strings.QuadraMenu_Rescan}" Click="RescanMenu_Click"/>
                            <MenuItem Header="{x:Static properties:Strings.QuadraMenu_SortBy}">
                                <MenuItem Header="{x:Static properties:Strings.QuadraMenu_SortName}" Click="SortByName_Click"/>
                                <MenuItem Header="{x:Static properties:Strings.QuadraMenu_SortType}" Click="SortByType_Click"/>
                                <MenuItem Header="{x:Static properties:Strings.QuadraMenu_SortDate}" Click="SortByDate_Click"/>
                                <MenuItem Header="{x:Static properties:Strings.QuadraMenu_SortManual}" Click="SortByManual_Click"/>
                            </MenuItem>
                            <MenuItem Header="{x:Static properties:Strings.QuadraMenu_NewFolder}" Click="NewFolderMenu_Click"/>
                            <MenuItem Header="{x:Static properties:Strings.QuadraMenu_NewQuadra}" Click="NewQuadraMenu_Click"/>
                            <MenuItem Header="{x:Static properties:Strings.QuadraMenu_Rename}" Click="RenameQuadraMenu_Click"/>
                            <MenuItem x:Name="LockQuadraMenuItem" Header="{x:Static properties:Strings.QuadraMenu_LockQuadra}" IsCheckable="True" Click="LockQuadraMenu_Click"/>
                            <MenuItem x:Name="ResizeQuadraMenuItem" Header="{x:Static properties:Strings.QuadraMenu_ResizeQuadra}" Click="ResizeQuadraMenu_Click" Visibility="Collapsed"/>
                            <MenuItem Header="{x:Static properties:Strings.QuadraMenu_CloseQuadra}" Click="CloseButton_Click"/>
                            <!-- T1 terceiros (vazio + barra: MESMA instância, um ponto só): Separator
                                 padrão + placeholder desabilitado. Sem Style no item (ApplyStyleRecursively
                                 aplica a densidade na abertura), tudo via token. -->
                            <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                            <MenuItem x:Name="ThirdPartyPlaceholderItem" Header="{x:Static properties:Strings.ThirdParty_NoActions}" IsEnabled="False"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid Margin="{DynamicResource Quadra.Density.Title.Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Título com sombra para contraste em papéis de parede claros ou escuros -->
                        <TextBlock x:Name="TitleTextBlock"
                                   Grid.Column="0"
                                   Text="{Binding Title}"
                                   Foreground="{DynamicResource Quadra.Title.Foreground}"
                                   FontSize="{DynamicResource Quadra.Title.FontSize}"
                                   FontWeight="{DynamicResource Quadra.Title.FontWeight}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="{DynamicResource Quadra.Title.Shadow.BlurRadius}"
                                                  ShadowDepth="{DynamicResource Quadra.Title.Shadow.Depth}"
                                                  Opacity="{DynamicResource Quadra.Title.Shadow.Opacity}"
                                                  Color="{DynamicResource Quadra.Title.Shadow.Color}"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Edição inline do título (fatia Renomear): REUSE tokens do tema, sem cor chapada -->
                        <TextBox x:Name="TitleEditBox"
                                 Grid.Column="0"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"
                                 FontSize="{DynamicResource Quadra.Title.FontSize}"
                                 FontWeight="{DynamicResource Quadra.Title.FontWeight}"
                                 Foreground="{DynamicResource Quadra.Title.Foreground}"
                                 Background="{DynamicResource Quadra.Background}"
                                 BorderBrush="{DynamicResource Quadra.Item.Selected.BorderBrush}"
                                 BorderThickness="{DynamicResource Quadra.Item.BorderThickness}"
                                 KeyDown="TitleEditBox_KeyDown"
                                 LostFocus="TitleEditBox_LostFocus"/>

                        <!-- Cadeado discreto de Quadra travada -->
                        <TextBlock x:Name="LockIndicator"
                                   Grid.Column="1"
                                   Text="🔒"
                                   FontSize="{DynamicResource Quadra.Lock.FontSize}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   Visibility="Collapsed"
                                   ToolTip="{x:Static properties:Strings.Quadra_LockedTooltip}"/>

                        <!-- Botão Recolher/Expandir (roll-up; Normal 24x24, Touch 44 hitbox) -->
                        <Button x:Name="CollapseButton"
                                Grid.Column="2"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="{x:Static properties:Strings.Quadra_CollapseTooltip}"
                                Click="CollapseButton_Click"
                                Margin="{DynamicResource Quadra.Density.TitleButton.Margin}">
                            <TextBlock x:Name="CollapseGlyph" Text="˄" FontSize="{DynamicResource Quadra.CollapseGlyph.FontSize}" FontWeight="Bold"/>
                        </Button>

                        <!-- Botão Adicionar Atalho / Arquivo -->
                        <Button x:Name="AddFileButton"
                                Grid.Column="3"
                                  Style="{StaticResource TitleBarButtonStyle}"
                                  ToolTip="{x:Static properties:Strings.Quadra_AddTooltip}"
                                  Click="AddFileButton_Click"
                                  Margin="{DynamicResource Quadra.Density.TitleButton.Margin}">
                             <TextBlock Text="+" FontSize="{DynamicResource Quadra.AddGlyph.FontSize}" FontWeight="Bold"/>
                         </Button>

                           <!-- Botão Fechar / Ocultar -->
                        <Button x:Name="CloseButton"
                                Grid.Column="4"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="{x:Static properties:Strings.Quadra_CloseTooltip}"
                                Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="{DynamicResource Quadra.CloseGlyph.FontSize}" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Área interna / Grid de Atalhos da Quadra -->
                <Grid x:Name="ContentArea" Grid.Row="1" Margin="6,4">
                    <!-- Mensagem para Quadra vazia -->
                    <Border BorderBrush="{DynamicResource Quadra.Empty.BorderBrush}"
                            BorderThickness="{DynamicResource Quadra.Empty.BorderThickness}"
                            CornerRadius="{DynamicResource Quadra.Empty.CornerRadius}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="{DynamicResource Quadra.Empty.Padding}"
                            Visibility="{Binding EmptyMessageVisibility}">
                        <TextBlock Text="{x:Static properties:Strings.Quadra_EmptyMessage}"
                                   Foreground="{DynamicResource Quadra.Empty.Foreground}"
                                   FontSize="{DynamicResource Quadra.Empty.FontSize}"
                                   FontStyle="{DynamicResource Quadra.Empty.FontStyle}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Lista com rolagem suave de atalhos e ícones em WrapPanel com suporte nativo a toque (restaurado de 6a05e6c) -->
                    <ScrollViewer x:Name="ItemsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  PanningRatio="1.0"
                                  PanningDeceleration="0.001"
                                  IsManipulationEnabled="True"
                                  ManipulationBoundaryFeedback="ScrollViewer_ManipulationBoundaryFeedback"
                                  Padding="2"
                                  Background="Transparent"
                                  PreviewMouseRightButtonDown="ItemsEmpty_PreviewMouseRightButtonDown"
                                  Focusable="False">
                        <ItemsControl x:Name="ItemsGrid" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemWidth="78" ItemHeight="96"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            CornerRadius="{DynamicResource Quadra.Item.CornerRadius}"
                                            Padding="{DynamicResource Quadra.Item.Padding}"
                                            Margin="{DynamicResource Quadra.Item.Margin}"
                                            Cursor="Hand"
                                            ToolTipService.Placement="Mouse"
                                            ToolTipService.HorizontalOffset="12"
                                            ToolTipService.VerticalOffset="16"
                                            ToolTipService.InitialShowDelay="500"
                                            ToolTipService.BetweenShowDelay="300"
                                            ToolTipService.ShowDuration="10000"
                                            ToolTip="{Binding ToolTipText}"
                                            ToolTipOpening="DesktopItem_ToolTipOpening"
                                            ToolTipClosing="DesktopItem_ToolTipClosing"
                                            MouseLeave="DesktopItem_MouseLeave"
                                            ContextMenuOpening="DesktopItem_ContextMenuOpening"
                                            PreviewMouseLeftButtonDown="DesktopItem_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="DesktopItem_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="DesktopItem_PreviewMouseLeftButtonUp">
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                                <MenuItem Header="{x:Static properties:Strings.ItemMenu_Open}" Style="{StaticResource MouseMenuItemStyle}" Click="ItemMenuOpen_Click"/>
                                                <MenuItem Header="{x:Static properties:Strings.ItemMenu_OpenLocation}" Style="{StaticResource MouseMenuItemStyle}" Click="ItemMenuOpenLocation_Click"/>
                                                <MenuItem Header="{x:Static properties:Strings.ItemMenu_Rename}" Click="ItemMenuRename_Click"/>
                                                <MenuItem Header="{x:Static properties:Strings.ItemMenu_Remove}" Style="{StaticResource MouseMenuItemStyle}" Click="ItemMenuRemove_Click"/>
                                                <MenuItem Header="{x:Static properties:Strings.ItemMenu_Delete}" Style="{StaticResource MouseMenuItemStyle}" Click="ItemMenuDelete_Click"/>
                                                <MenuItem x:Name="ItemMenuMoveItem" Header="{x:Static properties:Strings.ItemMenu_Move}" Style="{StaticResource MouseMenuItemStyle}" Click="ItemMenuMove_Click" Visibility="Collapsed"/>
                                                <!-- T1 terceiros (ícone): Separator padrão + placeholder desabilitado.
                                                     Sem Style no item (ApplyStyleRecursively aplica a densidade na abertura). -->
                                                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                                                <MenuItem x:Name="ThirdPartyPlaceholderItem" Header="{x:Static properties:Strings.ThirdParty_NoActions}" IsEnabled="False"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="{DynamicResource Quadra.Item.BorderThickness}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Quadra.Item.Hover.Background}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Quadra.Item.Hover.BorderBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Quadra.Item.Selected.Background}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Quadra.Item.Selected.BorderBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Quadra.Item.Hover.Background}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Quadra.Item.Selected.BorderBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                        <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="44"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Ícone do arquivo em alta resolução -->
                                            <Image Grid.Row="0"
                                                   Source="{Binding Icon}"
                                                   Width="{DynamicResource Quadra.Density.Icon.Size}"
                                                   Height="{DynamicResource Quadra.Density.Icon.Size}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- Nome do arquivo com sombra suave para legibilidade WCAG AA 4.5:1 -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name}"
                                                       Foreground="{DynamicResource Quadra.Item.Foreground}"
                                                       FontSize="{DynamicResource Quadra.Item.FontSize}"
                                                       LineHeight="{DynamicResource Quadra.Item.LineHeight}"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Top"
                                                       MaxHeight="{DynamicResource Quadra.Item.Title.MaxHeight}"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="{DynamicResource Quadra.Item.Shadow.BlurRadius}"
                                                                      ShadowDepth="{DynamicResource Quadra.Item.Shadow.Depth}"
                                                                      Opacity="{DynamicResource Quadra.Item.Shadow.Opacity}"
                                                                      Color="{DynamicResource Quadra.Item.Shadow.Color}"/>
                                                </TextBlock.Effect>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Edição inline do item (fatia Renomear): REUSE tokens do tema, sem cor chapada -->
                                            <TextBox Grid.Row="1"
                                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{DynamicResource Quadra.Item.FontSize}"
                                                     Foreground="{DynamicResource Quadra.Item.Foreground}"
                                                     Background="{DynamicResource Quadra.Background}"
                                                     BorderBrush="{DynamicResource Quadra.Item.Selected.BorderBrush}"
                                                     BorderThickness="{DynamicResource Quadra.Item.BorderThickness}"
                                                     TextAlignment="Center"
                                                     TextWrapping="Wrap"
                                                     MaxHeight="48"
                                                     Margin="0,1,0,0"
                                                     Padding="2,1"
                                                     IsVisibleChanged="ItemEditBox_IsVisibleChanged"
                                                     KeyDown="ItemEditBox_KeyDown"
                                                     LostFocus="ItemEditBox_LostFocus">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Retângulo de seleção com mouse (Marquee / Rubber-band) -->
                    <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                        <Border x:Name="SelectionBox"
                                Visibility="Collapsed"
                                Background="{DynamicResource Selection.Background}"
                                BorderBrush="{DynamicResource Selection.BorderBrush}"
                                BorderThickness="{DynamicResource Selection.BorderThickness}"
                                CornerRadius="{DynamicResource Selection.CornerRadius}"/>
                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- Manipuladores de Redimensionamento (Thumbs) -->
        <!-- ========================================== -->

        <!-- Bordas Simples -->
        <primitives:Thumb x:Name="ResizeThumbTop" Height="6" VerticalAlignment="Top" Margin="6,0,6,0"
                          Cursor="SizeNS" Style="{StaticResource ResizeThumbStyle}"
                          DragDelta="ResizeTop_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <primitives:Thumb x:Name="ResizeThumbBottom" Height="6" VerticalAlignment="Bottom" Margin="6,0,6,0"
                          Cursor="SizeNS" Style="{StaticResource ResizeThumbStyle}"
                          DragDelta="ResizeBottom_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <primitives:Thumb x:Name="ResizeThumbLeft" Width="6" HorizontalAlignment="Left" Margin="0,6,0,6"
                          Cursor="SizeWE" Style="{StaticResource ResizeThumbStyle}"
                          DragDelta="ResizeLeft_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <primitives:Thumb x:Name="ResizeThumbRight" Width="6" HorizontalAlignment="Right" Margin="0,6,0,6"
                          Cursor="SizeWE" Style="{StaticResource ResizeThumbStyle}"
                          DragDelta="ResizeRight_DragDelta" DragCompleted="Resize_DragCompleted"/>

        <!-- Cantos (Diagonal) -->
        <primitives:Thumb x:Name="ResizeThumbTopLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Cursor="SizeNWSE" Style="{StaticResource ResizeThumbStyle}"
                          DragDelta="ResizeTopLeft_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <primitives:Thumb x:Name="ResizeThumbTopRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Cursor="SizeNESW" Style="{StaticResource ResizeThumbStyle}"
                          DragDelta="ResizeTopRight_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <primitives:Thumb x:Name="ResizeThumbBottomLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Cursor="SizeNESW" Style="{StaticResource ResizeThumbStyle}"
                          DragDelta="ResizeBottomLeft_DragDelta" DragCompleted="Resize_DragCompleted"/>
        <primitives:Thumb x:Name="ResizeThumbBottomRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Cursor="SizeNWSE" Style="{StaticResource ResizeThumbStyle}"
                          DragDelta="ResizeBottomRight_DragDelta" DragCompleted="Resize_DragCompleted"/>

        <!-- Alças visíveis do RESIZE-via-touch (só com armado; tap atravessa p/ os thumbs) -->
        <Grid x:Name="TouchResizeHandlesOverlay"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <!-- Cantos -->
            <Ellipse Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Fill="{DynamicResource Quadra.Item.Selected.BorderBrush}" IsHitTestVisible="False"/>
            <Ellipse Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="{DynamicResource Quadra.Item.Selected.BorderBrush}" IsHitTestVisible="False"/>
            <Ellipse Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Fill="{DynamicResource Quadra.Item.Selected.BorderBrush}" IsHitTestVisible="False"/>
            <Ellipse Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Fill="{DynamicResource Quadra.Item.Selected.BorderBrush}" IsHitTestVisible="False"/>
            <!-- Meios de borda -->
            <Ellipse Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Fill="{DynamicResource Quadra.Item.Selected.BorderBrush}" IsHitTestVisible="False"/>
            <Ellipse Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Fill="{DynamicResource Quadra.Item.Selected.BorderBrush}" IsHitTestVisible="False"/>
            <Ellipse Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Fill="{DynamicResource Quadra.Item.Selected.BorderBrush}" IsHitTestVisible="False"/>
            <Ellipse Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Fill="{DynamicResource Quadra.Item.Selected.BorderBrush}" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
